{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "**/.*",
      "**/.*/**",
      "node_modules/**",
      "test/**",
      "docs/**",
      "*.md",
      "package.json",
      "package-lock.json",
      "*.log"
    ]
  }
}
