{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z2-9]{6}$/)",
        ".write": "$code.matches(/^[A-Z2-9]{6}$/)",
        "created": { ".validate": "newData.isNumber()" },
        "round": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 500" },
        "players": {
          "$player": {
            ".validate": "newData.hasChildren(['n', 's'])",
            "n": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "s": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "answers": {
          "$round": {
            "$answer": {
              ".validate": "newData.hasChildren(['t', 'g'])",
              "t": { ".validate": "newData.isString() && newData.val().length <= 80" },
              "g": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            }
          }
        },
        "out": {
          "$round": {
            "$player": { ".validate": "newData.isBoolean()" }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
